{
  "name": "termdock",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project t0",
    "test:area": "node scripts/test-area.ts",
    "test:release": "node scripts/test-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
