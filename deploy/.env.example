# Copy to deploy/.env (gitignored) and adjust; Docker Compose reads it automatically for
# `docker compose -f deploy/compose.yaml ...`. Variables exported in the shell take precedence.

# Public name of the instance (the Caddy site address). `localhost` is for a local trial.
TERMDOCK_DOMAIN=localhost

# Host ports Caddy publishes (and listens on inside its container).
TERMDOCK_HTTP_PORT=80
TERMDOCK_HTTPS_PORT=443

# Browser-facing URL. Default: https://<TERMDOCK_DOMAIN>:<TERMDOCK_HTTPS_PORT>. Set it only when
# browsers reach Termdock under a different URL (e.g. a port forward in front of this host).
# TERMDOCK_PUBLIC_URL=https://termdock.example.com

# TLS: auto (Caddy's automatic HTTPS: local CA for localhost/IPs, ACME for public domains)
# or internal (always Caddy's local CA, e.g. for a LAN-only name).
# TERMDOCK_TLS=auto

# session-manager log level: fatal | error | warn | info | debug | trace | silent
# TERMDOCK_LOG_LEVEL=info
